// SQLite has no enum type, so every "enum" is a String with its allowed values
// listed above it. The same values live in server/src/lib/constants.js and
// src/lib/constants.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PEOPLE
// ---------------------------------------------------------------------------

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String

  // ADMIN | SALES_REP | SALES_MANAGER | FINANCE | CUSTOMER
  // Empty until an admin approves the person and picks their role. Someone
  // waiting for approval has no role at all, so there is nothing to misuse.
  role String?

  // PENDING | ACTIVE | REJECTED | DISABLED
  // Only ACTIVE can log in. New signups start at PENDING.
  status String @default("PENDING")

  // The role the person asked for when they signed up. Advisory only — the
  // admin picks the real role on approval, so this can never grant anything.
  requestedRole String?

  // Who approved the request, when, and why it was turned down.
  approvedById    Int?
  approvedBy      User?     @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers   User[]    @relation("UserApprovals")
  approvedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())

  // Portal users are tied to the customer whose quotes they may see.
  customerId Int?
  customer   Customer? @relation(fields: [customerId], references: [id])

  quotations     Quotation[]     @relation("QuotationRep")
  approvalSteps  ApprovalStep[]
  activityLogs   ActivityLog[]
  portalMessages PortalMessage[]
  notifications  Notification[]
}

model Tier {
  id   String @id
  name String @unique
  // Ceiling for the customer tier as a whole (Bronze 5, Silver 10, Gold 15).
  // Category ceilings are checked on top of this — see Category.
  maxDiscountPct Float
  sequence       Int    @default(0)

  customers  Customer[]
  priceLists PriceList[]
}

model Customer {
  id      Int     @id @default(autoincrement())
  name    String
  email   String  @unique
  phone   String?
  city    String?
  state   String?
  tierId  String
  tier    Tier    @relation(fields: [tierId], references: [id])
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  portalUsers   User[]
  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
}

// ---------------------------------------------------------------------------
// CATALOGUE
// ---------------------------------------------------------------------------

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  // The discount a rep may give on this category without approval.
  // Services are thinner margin than hardware, so their ceiling is lower.
  discountCeilingPct Float

  products Product[]
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String
  sku        String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  unit       String   @default("unit")
  taxRatePct Float    @default(18)
  salesPrice Float
  cost       Float

  // Two independent questions:
  //   isStockable        -> does it need a warehouse? (fulfilment)
  //   defaultBillingType -> charged once or every period? (billing)
  // A rental is both; a support plan is neither. One field must not answer both.
  isStockable  Boolean @default(true)
  isReturnable Boolean @default(false)

  // ONE_TIME | RECURRING — only the DEFAULT. The quotation line decides.
  defaultBillingType String  @default("ONE_TIME")
  defaultPlanId      String?
  defaultPlan        RecurringPlan? @relation(fields: [defaultPlanId], references: [id])

  // Free warranty is an attribute of the product, not a sellable line.
  warrantyMonths Int?

  // Used by the upsell panel.
  isPromoted   Boolean @default(false)
  minMarginPct Float   @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  variants       ProductVariant[]
  priceListItems PriceListItem[]
  stocks         Stock[]
  quotationLines QuotationLine[]
  upsellFrom     UpsellRule[]     @relation("UpsellSource")
  upsellTo       UpsellRule[]     @relation("UpsellSuggested")
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Float   @default(0)
}

model PriceList {
  id       Int     @id @default(autoincrement())
  name     String
  tierId   String?
  tier     Tier?   @relation(fields: [tierId], references: [id])
  currency String  @default("INR")
  isActive Boolean @default(true)

  items PriceListItem[]
}

model PriceListItem {
  id          Int       @id @default(autoincrement())
  priceListId Int
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  price       Float

  @@unique([priceListId, productId])
}

model RecurringPlan {
  id String @id
  name String @unique
  // MONTH | QUARTER | YEAR
  interval         String
  intervalCount    Int     @default(1)
  prorationEnabled Boolean @default(true)

  products       Product[]
  quotationLines QuotationLine[]
  subscriptions  Subscription[]
}

// ---------------------------------------------------------------------------
// INVENTORY
// ---------------------------------------------------------------------------

model Warehouse {
  id   Int    @id @default(autoincrement())
  name String
  code String @unique
  city String?
  // Relative cost of shipping from here. The split prefers cheaper warehouses
  // and fewer shipments.
  shippingWeight Float   @default(1)
  isActive       Boolean @default(true)

  stocks      Stock[]
  fulfilments Fulfilment[]
}

model Stock {
  id           Int       @id @default(autoincrement())
  warehouseId  Int
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty          Int       @default(0)
  reorderLevel Int       @default(0)

  @@unique([warehouseId, productId])
}

// ---------------------------------------------------------------------------
// THE DEAL — quotation and order are ONE table
// ---------------------------------------------------------------------------

model Quotation {
  id     Int    @id @default(autoincrement())
  number String @unique

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  repId      Int
  rep        User     @relation("QuotationRep", fields: [repId], references: [id])

  // DRAFT | PENDING_APPROVAL | APPROVED | SENT | UNDER_NEGOTIATION | CONFIRMED | CANCELLED
  // A quotation becomes an order at CONFIRMED. No second table, nothing copied.
  status       String  @default("DRAFT")
  cancelReason String?

  promisedDeliveryDate  DateTime?
  estimatedDeliveryDate DateTime?

  // Blended discount risk, recalculated whenever lines change.
  riskScore       Float   @default(0)
  requiresFinance Boolean @default(false)

  // Deal health reads these two. lastActivityAt is refreshed by the
  // activity log, so "stalled" is measured from real events, never a flag.
  lastActivityAt       DateTime  @default(now())
  approvalPendingSince DateTime?

  // Discount applied to the whole order, on top of any line discount.
  orderDiscountPct Float @default(0)

  // Product ids the rep dismissed from the suggestion panel, comma separated.
  // Stored so a rejected suggestion does not come back when the quote reopens.
  dismissedUpsellIds String?

  confirmedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines          QuotationLine[]
  approvalSteps  ApprovalStep[]
  activityLogs   ActivityLog[]
  fulfilments    Fulfilment[]
  invoices       Invoice[]
  portalMessages PortalMessage[]
  notifications  Notification[]
}

model QuotationLine {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])

  qty         Int   @default(1)
  unitPrice   Float
  discountPct Float @default(0)

  // ONE_TIME | RECURRING — THE field that decides how this line is billed.
  // Copied from the product as a default, then the rep may change it.
  billingType String @default("ONE_TIME")
  planId      String?
  plan        RecurringPlan? @relation(fields: [planId], references: [id])

  // Recurring lines only. endDate null = open-ended subscription;
  // a set endDate = fixed term (rental or an AMC).
  startDate DateTime?
  endDate   DateTime?

  fulfilmentLines FulfilmentLine[]
  subscription    Subscription?
}

// ---------------------------------------------------------------------------
// GOVERNANCE — approvals and the audit trail
// ---------------------------------------------------------------------------

model ApprovalRule {
  id       Int    @id @default(autoincrement())
  name     String
  // Overage is how many discount points a quotation is over its ceilings.
  // A rule matches when overage falls inside its band.
  minOveragePoints Float
  maxOveragePoints Float?
  requiresManager  Boolean @default(true)
  requiresFinance  Boolean @default(false)
  sequence         Int     @default(0)
  isActive         Boolean @default(true)
}

model ApprovalStep {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sequence    Int
  // Which role must act: SALES_MANAGER | FINANCE
  role        String
  // PENDING | APPROVED | REJECTED | RETURNED
  status      String    @default("PENDING")
  actorId     Int?
  actor       User?     @relation(fields: [actorId], references: [id])
  reason      String?
  actedAt     DateTime?
  createdAt   DateTime  @default(now())
}

model ActivityLog {
  id          Int        @id @default(autoincrement())
  quotationId Int?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id])
  action      String
  detail      String?
  createdAt   DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// FULFILMENT — only stockable lines ever reach a warehouse
// ---------------------------------------------------------------------------

model Fulfilment {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouseId Int
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  // SUGGESTED | ACCEPTED | BACKORDER | SHIPPED | DELIVERED | RETURNED
  status           String    @default("SUGGESTED")
  shipmentCost     Float     @default(0)
  estDeliveryDate  DateTime?
  isManualOverride Boolean   @default(false)
  createdAt        DateTime  @default(now())

  lines FulfilmentLine[]
}

model FulfilmentLine {
  id              Int           @id @default(autoincrement())
  fulfilmentId    Int
  fulfilment      Fulfilment    @relation(fields: [fulfilmentId], references: [id], onDelete: Cascade)
  quotationLineId Int
  quotationLine   QuotationLine @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  qty             Int
}

// ---------------------------------------------------------------------------
// BILLING — one order can produce one immediate invoice plus many recurring ones
// ---------------------------------------------------------------------------

model Subscription {
  id              Int           @id @default(autoincrement())
  quotationLineId Int           @unique
  quotationLine   QuotationLine @relation(fields: [quotationLineId], references: [id], onDelete: Cascade)
  customerId      Int
  customer        Customer      @relation(fields: [customerId], references: [id])
  planId          String
  plan            RecurringPlan @relation(fields: [planId], references: [id])

  qty         Int
  unitPrice   Float
  discountPct Float @default(0)

  startDate       DateTime
  nextBillingDate DateTime
  endDate         DateTime?
  // ACTIVE | PAUSED | CANCELLED | ENDED
  status      String    @default("ACTIVE")
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  schedules BillingSchedule[]
}

model BillingSchedule {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  amount         Float
  // True when the period was cut short or started late and charged at a
  // daily rate for the days actually used.
  isProrated Boolean @default(false)
  // SCHEDULED | INVOICED | PAID
  status    String  @default("SCHEDULED")
  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
}

model Invoice {
  id          Int       @id @default(autoincrement())
  number      String    @unique
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  // ONE_TIME | RECURRING — which half of a mixed order this invoice covers.
  type      String
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  subtotal  Float     @default(0)
  taxAmount Float     @default(0)
  total     Float     @default(0)
  // DRAFT | ISSUED | PARTIALLY_PAID | PAID | CANCELLED
  status String @default("DRAFT")

  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]
  schedules   BillingSchedule[]
}

model InvoiceLine {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  qty         Int     @default(1)
  unitPrice   Float
  discountPct Float   @default(0)
  taxRatePct  Float   @default(0)
  lineTotal   Float

  quotationLineId Int?
}

model Payment {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // CASH | BANK | CARD | UPI
  method    String
  amount    Float
  reference String?
  paidAt    DateTime @default(now())
}

model CreditNote {
  id        Int      @id @default(autoincrement())
  invoiceId Int
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  reason    String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CUSTOMER PORTAL
// ---------------------------------------------------------------------------

model PortalMessage {
  id          Int       @id @default(autoincrement())
  quotationId Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  // Set when the customer is commenting on one specific line.
  quotationLineId Int?
  authorId        Int
  author          User   @relation(fields: [authorId], references: [id])
  text            String
  // A counter-offer. When accepted this re-scores the quote, which can send it
  // back through approval on its own.
  counterDiscountPct Float?
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CONFIGURATION
// ---------------------------------------------------------------------------

model UpsellRule {
  id                 Int     @id @default(autoincrement())
  productId          Int
  product            Product @relation("UpsellSource", fields: [productId], references: [id], onDelete: Cascade)
  suggestedProductId Int
  suggestedProduct   Product @relation("UpsellSuggested", fields: [suggestedProductId], references: [id], onDelete: Cascade)
  weight             Float   @default(1)
  isActive           Boolean @default(true)

  @@unique([productId, suggestedProductId])
}

// One row only (id is always 1). Every threshold that might need changing at
// runtime lives here rather than in the code.
model Settings {
  id       Int    @id @default(1)
  currency String @default("INR")

  // Deal health thresholds
  stalledAfterDays            Int   @default(7)
  discountAnomalyThresholdPct Float @default(10)
  minQuotesForRepAverage      Int   @default(5)
  // Penalty weights as JSON text — SQLite has no JSON column type.
  healthWeights String @default("{\"stalledPerDay\":3,\"stalledCap\":30,\"discountAnomaly\":25,\"slippagePerDay\":3,\"slippageCap\":25,\"approvalWaitPerDay\":2,\"approvalWaitCap\":20}")

  // Approval routing
  financeApprovalOveragePoints Float @default(10)

  // Fulfilment
  defaultShippingCost Float @default(250)

  // Suggestions below this margin are never shown, so the panel cannot talk a
  // rep into a product that damages the deal.
  minUpsellMarginPct Float @default(20)

  updatedAt DateTime @updatedAt
}

// In-app alert for one person. Created alongside an email and a live event, so
// the three channels always carry the same news.
model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // APPROVAL_REQUESTED | APPROVAL_ESCALATED | QUOTATION_APPROVED |
  // QUOTATION_REJECTED | QUOTATION_RETURNED | QUOTATION_ACCEPTED
  type  String
  title String
  body  String?

  quotationId Int?
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

// Outbound mail. Held in the database rather than in memory so a restart does
// not lose the record and an admin can read back what was sent.
model EmailMessage {
  id      Int    @id @default(autoincrement())
  to      String
  subject String
  body    String

  // QUEUED | SENT | FAILED. Stays QUEUED while no SMTP host is configured.
  status String  @default("QUEUED")
  error  String?

  quotationId Int?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
}
