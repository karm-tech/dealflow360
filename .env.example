# Copy this file to .env before running the app.

# Two separate SQLite files, so exploring the demo can never touch real data.
#   dev.db   the live instance  (master data only after seeding)
#   demo.db  the demo instance  (sample customers, quotes and history)
# Both live in server/prisma/. No database server needed.
DATABASE_URL="file:./dev.db"
DEMO_DATABASE_URL="file:./demo.db"

# Signs the login tokens. Any long random string works for the demo.
JWT_SECRET="change-me-to-a-long-random-string"

# Where the API listens, and which origin it trusts.
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# SMTP is optional. Leave SMTP_HOST blank and the app writes every message to
# the outbox without sending, so the app runs with no internet.
#
# These are the values a freshly seeded database starts with. After that the
# Mail settings screen is what the app reads, so a change there takes effect on
# the next message without a restart or a reseed.
#
# For Gmail, use an app password, not the account password. Turn on 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords.
# Gmail sends as the authenticated account whatever MAIL_FROM says, so keep the
# address in MAIL_FROM the same as SMTP_USER.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-character-app-password"
MAIL_FROM="DealFlow360 <you@gmail.com>"
