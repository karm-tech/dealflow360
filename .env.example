# Copy this file to .env before running the app.

# Two separate SQLite files, so exploring the demo can never touch real data.
#   dev.db   the live instance  (master data only after seeding)
#   demo.db  the demo instance  (sample customers, quotes and history)
# Both live in server/prisma/. No database server needed.
DATABASE_URL="file:./dev.db"
DEMO_DATABASE_URL="file:./demo.db"

# Signs the login tokens. Any long random string works for the demo.
JWT_SECRET="change-me-to-a-long-random-string"

# Where the API listens, and which origin it trusts.
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# SMTP is optional. When these are blank the app logs email to an outbox
# instead of sending, so the demo still works with no internet.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="DealFlow360 <no-reply@dealflow360.local>"
